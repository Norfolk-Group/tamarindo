# Public (NEXT_PUBLIC_*) values baked into the production bundle at build time.
# Committed on purpose: without them `next build` falls back to the localhost
# values in .env, and the deployed Worker sends users to a laptop that is not
# there. Secrets never belong in this file — those are Worker secrets.

NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://tamarindo-web.norfolk-ai.workers.dev/callback
NEXT_PUBLIC_NICO_AGENT_URL=https://tamarindo-nico-agent.norfolk-ai.workers.dev
