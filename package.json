{
  "name": "tamarindo-nico",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "ae2": "tsx scripts/ae2-resume.mjs",
    "ae2:chrome": "tsx scripts/ae2-chrome.mjs",
    "test:watch": "vitest",
    "postinstall": "prisma generate && node scripts/sync-knowledge-corpus.mjs",
    "knowledge:sync": "node scripts/sync-knowledge-corpus.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env -- prisma db seed"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/react": "^4.0.80",
    "@cloudflare/ai-chat": "^0.10.2",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^6.19.1",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.10.0",
    "agents": "^0.21.0",
    "ai": "^7.0.77",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer": "^25.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "recharts": "^2.15.4",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "wrangler": "^4.125.0"
  }
}
