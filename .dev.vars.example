# Local Workers / wrangler secrets mirror. Copy to .dev.vars (gitignored).
# Same keys as .env.example — keep them in sync by hand for now.
NEXTJS_ENV=development

# Local Docker, or the Hyperdrive connection string on Workers.
DATABASE_URL=postgresql://norfolk:norfolk@localhost:5432/norfolk_dev?schema=public

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Session idle window in seconds — without it AuthKit keeps you signed in
# for 400 days. Also sent as OIDC max_age so Google re-prompts.
WORKOS_COOKIE_MAX_AGE=900
# Comma separated emails that get admin on sign-in (owner allowlist).
ADMIN_EMAILS=
NICO_HANDSHAKE_SECRET=
NICO_AGENT_URL=http://127.0.0.1:8788
# Wrangler-only. Next.js does not load this file into the browser bundle —
# keep the same key in `.env` so the copilot can attach.
NEXT_PUBLIC_NICO_AGENT_URL=http://127.0.0.1:8788
# Sibling Worker also reads workers/nico-agent/.dev.vars — see that example.
# EXA_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_AIG_GATEWAY_ID=

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_GATEWAY_URL=
# Strong/analytical tier. Default claude-sonnet-4-5
# NICO_MODEL=
# Fast tier for conversational turns. Default claude-haiku-4-5
# NICO_FAST_MODEL=
# Abort if the gateway sends no first token in this many ms (default 6000)
# NICO_FIRST_TOKEN_TIMEOUT_MS=
# Abort a stream that runs past this many ms in total (default 90000)
# NICO_STREAM_TIMEOUT_MS=
