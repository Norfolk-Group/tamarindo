{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["./*"],
      "@prisma/client": ["./lib/generated/prisma"]
    }
  },
  "include": ["src/**/*.ts", "../../lib/**/*.ts"]
}
