# ── Database ────────────────────────────────────────────────────────────
# Local: docker compose (pgvector/pgvector:pg16)
# Production: Neon pooled connection string for the app; unpooled for migrate
DATABASE_URL=postgresql://norfolk:norfolk@localhost:5432/norfolk_dev?schema=public
# Hosted Neon (do not replace DATABASE_URL for local work)
# NEON_DATABASE_URL=
# NEON_DATABASE_URL_DIRECT=

# ── Identity (WorkOS AuthKit) ───────────────────────────────────────────
# Leave empty only on local Docker. Preview/production with empty keys
# must not mint the `dev-local` admin (DATABASE_URL must not be localhost).
# Local loopback: even with WorkOS keys set, curl/agents without a cookie
# become `dev-local` unless you set ALLOW_DEV_LOCAL=0.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# Must be at least 32 characters. Generate with: openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Hosted origins also allow (production canonical first):
#   https://asknico.ai/callback
#   https://tamarindo-web.norfolk-ai.workers.dev/callback
# WorkOS dashboard → Redirects → Initiate login URL: http://localhost:3000/login

# Session idle window in seconds. AuthKit defaults to 400 days, so nobody is
# ever asked to sign in again — keep this set. Deployed value lives in
# wrangler.toml [vars]; the same number is sent as OIDC max_age.
WORKOS_COOKIE_MAX_AGE=900
# Comma separated emails that get admin on sign-in. Invitations can only grant
# member or investor, so without this a deployed app has no admin at all.
# Set as a Worker secret in production, never committed.
ADMIN_EMAILS=

# Short-lived OpenNext → Nico DO handshake (falls back to WORKOS_COOKIE_PASSWORD)
NICO_HANDSHAKE_SECRET=
# Sibling Nico Worker origin for approval resume (optional until wrangler preview)
NICO_AGENT_URL=http://127.0.0.1:8788
# Browser attach host. Must live in `.env` (Next.js). `.dev.vars` is Wrangler-only
# and is not inlined into the client bundle.
NEXT_PUBLIC_NICO_AGENT_URL=http://127.0.0.1:8788

# ── Invite accept (Turnstile) ──────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Sofia watch (Q9: Exa). Leave empty — the step fails closed and invents nothing.
# EXA_API_KEY=

# ── Channel webhooks (U9) ──────────────────────────────────────────────
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# RECALL_API_KEY=
# RECALL_REGION=us-west-2
# RECALL_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Nico <nico@norfolk.ai>
# RESEND_WEBHOOK_SECRET=

# ── Cloudflare AI Gateway ───────────────────────────────────────────────
# Preferred: unified REST API (no Anthropic key needed if Unified Billing
# is enabled). Docs: https://developers.cloudflare.com/ai-gateway/usage/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: route through a named gateway instead of the account default
CF_AIG_GATEWAY_ID=

# Anthropic via the AI SDK. This is what makes Nico talk like a person.
# ANTHROPIC_API_KEY=
# Gemini (Nano Banana Pro images + Veo video). Same key as AI Studio.
# GEMINI_API_KEY=
# Mistral OCR for scanned PDFs / weak pdftotext extracts (local ingest only).
# MISTRAL_API_KEY=
# Optional: route the same key through Cloudflare AI Gateway
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic
# Strong/analytical tier. Default claude-opus-4-6 (financing, reports, ticket math)
# NICO_MODEL=
# Fast tier for conversational turns. Default claude-haiku-4-5
# NICO_FAST_MODEL=
# Abort if the gateway sends no first token in this many ms
# (default 6000 conversational / 25000 strong — thinking counts)
# NICO_FIRST_TOKEN_TIMEOUT_MS=
# Abort a stream that runs past this many ms in total
# (default 90000 conversational / 180000 strong)
# NICO_STREAM_TIMEOUT_MS=
# Extended thinking budget on the strong tier (default 8192)
# NICO_THINKING_BUDGET_TOKENS=
